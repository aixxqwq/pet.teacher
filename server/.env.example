# Скопируй этот файл в server/.env и вставь свой ключ DeepSeek (platform.deepseek.com → API keys).
# Файл .env не попадает в GitHub — ключ останется только на твоём компьютере.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash      # или deepseek-v4-pro (умнее, дороже)
# DEEPSEEK_THINKING=disabled         # enabled — с рассуждениями: точнее, но медленнее и дороже
# AI_DAILY_LIMIT=60                  # сколько вопросов учителю в день на одного ученика
# ADMIN_USERS=aisha                 # логины, которым видна страница «Админ» (через запятую)
